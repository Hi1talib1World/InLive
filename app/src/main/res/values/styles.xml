<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryDark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorOnSecondary">@color/MatteBlack</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/colorPrimary</item>

        <!-- Material 3 specific attributes -->
        <item name="colorSurface">@color/MatteBlack</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:colorBackground">@color/MatteBlack</item>
        <item name="colorOnBackground">@color/white</item>
    </style>

    <style name="MyAlertDialogStyle" parent="Theme.Material3.DayNight.Dialog.Alert">
        <!-- Used for the buttons -->
        <item name="colorPrimary">@color/RedAccent</item>
        <!-- Used for the background -->
        <item name="colorSurface">@color/DarkAccent</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
